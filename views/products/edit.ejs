<%- include('../partials/header') %>

    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
        <h1 class="text-3xl sm:text-4xl font-bold">Edit Product</h1>
        <a href="/products" class="btn btn-secondary btn-sm sm:btn-md">
            <i class="fas fa-arrow-left"></i> Back
        </a>
    </div>

    <div class="card card-bordered bg-base-200 shadow-lg max-w-3xl mx-auto">
        <div class="card-body p-4 sm:p-6 lg:p-8">
            <form action="/products/<%= product.id %>/update" method="POST" enctype="multipart/form-data" class="space-y-4 sm:space-y-6">
                <div class="form-control w-full">
                    <label class="label" for="name">
                        <span class="label-text font-semibold">Product Name</span>
                        <span class="label-text-alt text-error">*</span>
                    </label>
                    <input type="text" id="name" name="name" class="input input-bordered w-full" required value="<%= product.name %>">
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
                    <div class="form-control w-full">
                        <label class="label" for="price">
                            <span class="label-text font-semibold">Price ($)</span>
                            <span class="label-text-alt text-error">*</span>
                        </label>
                        <input type="number" id="price" name="price" class="input input-bordered w-full" required min="0" step="0.01" value="<%= product.price %>">
                    </div>

                    <div class="form-control w-full">
                        <label class="label" for="quantity">
                            <span class="label-text font-semibold">Quantity</span>
                            <span class="label-text-alt text-error">*</span>
                        </label>
                        <input type="number" id="quantity" name="quantity" class="input input-bordered w-full" required min="0" value="<%= product.quantity %>">
                    </div>
                </div>

                <% if (product.url_image) { %>
                    <div class="form-control w-full">
                        <label class="label">
                            <span class="label-text font-semibold">Current Image</span>
                        </label>
                        <div class="mt-2 flex justify-center sm:justify-start">
                            <div class="card bg-base-100 border border-base-content/20">
                                <figure class="max-w-xs">
                                    <img src="<%= product.url_image %>" alt="Current Image" class="rounded-lg object-cover max-h-48 w-full">
                                </figure>
                            </div>
                        </div>
                    </div>
                    <div class="divider"></div>
                <% } %>

                <div class="form-control w-full">
                    <label class="label" for="image">
                        <span class="label-text font-semibold">Update Image</span>
                        <span class="label-text-alt text-base-content/60">Optional</span>
                    </label>
                    <input type="file" id="image" name="image" class="file-input file-input-bordered w-full" accept="image/*">
                    <label class="label">
                        <span class="label-text-alt text-base-content/60">
                            <% if (product.url_image) { %>
                                Leave blank to keep current image
                            <% } else { %>
                                Supported formats: JPG, PNG, GIF
                            <% } %>
                        </span>
                    </label>
                </div>

                <div class="divider"></div>

                <div class="flex flex-col sm:flex-row justify-end gap-2 sm:gap-4 pt-2">
                    <a href="/products" class="btn btn-ghost btn-sm sm:btn-md order-2 sm:order-1">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-primary btn-sm sm:btn-md order-1 sm:order-2">
                        <i class="fas fa-save"></i> Update Product
                    </button>
                </div>
            </form>
        </div>
    </div>

    <%- include('../partials/footer') %>