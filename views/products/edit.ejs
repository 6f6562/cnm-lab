<!DOCTYPE html>
<html data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body class="min-h-screen flex flex-col">
    <%- include('../header') %>

    <main class="flex-1">
      <div class="container mx-auto p-4 max-w-3xl">
        <div class="breadcrumbs text-sm mb-4">
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/">Products</a></li>
            <li>Edit</li>
          </ul>
        </div>
        <% if (success) { %>
        <div class="alert alert-success mb-4">
          <span><%= success %></span>
        </div>
        <% } %>
        <% if (error) { %>
        <div class="alert alert-error mb-4">
          <span><%= error %></span>
        </div>
        <% } %>

        <% if (errors && errors.length > 0) { %>
        <div class="alert alert-warning mb-4">
          <div>
            <div class="font-bold mb-1">Please fix the following:</div>
            <ul class="list-disc pl-5">
              <% errors.forEach(function(e){ %>
              <li><%= e %></li>
              <% }); %>
            </ul>
          </div>
        </div>
        <% } %>

        <form class="space-y-4" method="POST" action="/products/<%= product.id %>" enctype="multipart/form-data">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="label">
                <span class="label-text">Name</span>
              </label>
              <input
                class="input input-bordered w-full"
                type="text"
                name="name"
                value="<%= product.name %>"
                required
              />
            </div>

            <div>
              <label class="label">
                <span class="label-text">Price</span>
              </label>
              <input
                class="input input-bordered w-full"
                type="number"
                name="price"
                step="0.01"
                value="<%= product.price %>"
                required
              />
            </div>

            <div>
              <label class="label">
                <span class="label-text">Unit In Stock</span>
              </label>
              <input
                class="input input-bordered w-full"
                type="number"
                name="unit_in_stock"
                step="1"
                value="<%= product.unit_in_stock %>"
                required
              />
            </div>

            <div>
              <label class="label">
              <span class="label-text">Image (bắt buộc để thay thế)</span>
              </label>
              <input
                class="file-input file-input-bordered w-full"
                type="file"
                name="image"
                accept="image/*"
                required
              />
            </div>
          </div>

          <div class="border rounded-box p-4">
            <div class="font-bold mb-2">Current Image</div>
            <% if (product.url_image) { %>
            <img src="<%= product.url_image %>" alt="<%= product.name %>" class="h-40 w-40 object-cover rounded" />
            <% } else { %>
            <span class="opacity-60">No image</span>
            <% } %>
            <div class="text-sm opacity-70 mt-2">Bạn cần chọn ảnh mới để cập nhật.</div>
          </div>

          <div class="flex gap-2">
            <button class="btn btn-primary" type="submit">Update</button>
            <a class="btn" href="/products/<%= product.id %>">Cancel</a>
          </div>
        </form>
      </div>
    </main>

    <%- include('../footer') %>

  </body>
</html>

