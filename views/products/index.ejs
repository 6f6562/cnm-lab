<%- include('../partials/header') %>

    <div class="flex justify-between items-center mb-8">
        <h1 class="text-4xl font-bold">All Products</h1>
        <a href="/products/create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add Product
        </a>
    </div>

    <% if (products && products.length> 0) { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            <% products.forEach(product=> { %>
                <div class="card card-bordered bg-base-200 shadow-lg hover:shadow-xl transition-shadow flex flex-col">
                    <% if (product.url_image) { %>
                        <figure class="h-48 bg-base-300 flex-shrink-0">
                            <img src="<%= product.url_image %>" alt="<%= product.name %>" class="w-full h-full object-cover">
                        </figure>
                    <% } else { %>
                        <figure class="h-48 bg-base-300 flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-image text-6xl text-base-content/30"></i>
                        </figure>
                    <% } %>
                    <div class="card-body flex flex-col flex-1">
                        <h2 class="card-title text-xl line-clamp-2 min-h-[3.5rem]" title="<%= product.name %>">
                            <%= product.name %>
                        </h2>
                        <div class="text-2xl font-bold text-primary mt-2">$<%= product.price %></div>
                        <div class="text-sm text-base-content/70 mt-1">
                            <span><i class="fas fa-box"></i> Stock: <%= product.quantity %></span>
                        </div>
                        <div class="card-actions justify-end mt-auto pt-4">
                            <a href="/products/<%= product.id %>/edit" class="btn btn-secondary btn-sm">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                            <form action="/products/<%= product.id %>/delete" method="POST" class="flex-1" onsubmit="return confirm('Are you sure?');">
                                <button type="submit" class="btn btn-error btn-sm w-full">
                                    <i class="fas fa-trash"></i> Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <div class="card bg-base-200 border-2 border-dashed border-base-content/20">
            <div class="card-body items-center text-center py-16">
                <div class="text-6xl text-base-content/30 mb-4">
                    <i class="fas fa-box-open"></i>
                </div>
                <h3 class="card-title text-2xl mb-2">No products found</h3>
                <p class="text-base-content/70 mb-6">Get started by adding your first product to the inventory.</p>
                <a href="/products/create" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Add Product
                </a>
            </div>
        </div>
    <% } %>

<%- include('../partials/footer') %>