<!DOCTYPE html>
<html data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body class="min-h-screen flex flex-col">
    <%- include('../header') %>

    <main class="flex-1">
      <div class="container mx-auto p-4">
        <% if (success) { %>
        <div class="alert alert-success mb-4">
          <span><%= success %></span>
        </div>
        <% } %>
        <% if (error) { %>
        <div class="alert alert-error mb-4">
          <span><%= error %></span>
        </div>
        <% } %>

        <div class="flex flex-col gap-3 mb-4">
          <form class="form-control w-full" method="GET" action="/">
            <label class="label">
              <span class="label-text">Search by name & price</span>
            </label>
            <div class="join w-full">
              <input
                type="text"
                name="q"
                value="<%= q %>"
                placeholder="Enter product name..."
                class="input input-bordered join-item w-full"
              />
              <button class="btn btn-outline join-item" type="submit">Search</button>
            </div>

            <div class="grid grid-cols-2 gap-2 mt-2">
              <div>
                <div class="text-xs opacity-70 mb-1">Min Price</div>
                <input
                  type="number"
                  name="min_price"
                  step="0.01"
                  value="<%= (typeof minPrice !== 'undefined' && minPrice != null) ? minPrice : '' %>"
                  placeholder="e.g. 10"
                  class="input input-bordered w-full"
                />
              </div>
              <div>
                <div class="text-xs opacity-70 mb-1">Max Price</div>
                <input
                  type="number"
                  name="max_price"
                  step="0.01"
                  value="<%= (typeof maxPrice !== 'undefined' && maxPrice != null) ? maxPrice : '' %>"
                  placeholder="e.g. 100"
                  class="input input-bordered w-full"
                />
              </div>
            </div>
          </form>

          <div class="flex-none self-end">
            <a class="btn btn-lg btn-primary" href="/products/new">Add Product</a>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="table table-zebra w-full">
            <thead>
              <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Price</th>
                <th>In Stock</th>
                <th>Image</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (!products || products.length === 0) { %>
              <tr>
                <td colspan="6" class="text-center">No products found.</td>
              </tr>
              <% } %>
              <% (products || []).forEach(function(p) { %>
              <tr>
                <td><%= p.id %></td>
                <td><%= p.name %></td>
                <td><%= p.price %></td>
                <td><%= p.unit_in_stock %></td>
                <td>
                  <% if (p.url_image) { %>
                  <img src="<%= p.url_image %>" alt="<%= p.name %>" class="h-16 w-16 object-cover rounded" />
                  <% } else { %>
                  <span class="text-sm opacity-60">N/A</span>
                  <% } %>
                </td>
                <td>
                  <div class="flex flex-wrap gap-2">
                    <a class="btn btn-xs btn-success" href="/products/<%= p.id %>">View</a>
                    <a class="btn btn-xs btn-primary" href="/products/<%= p.id %>/edit">Edit</a>
                    <form method="POST" action="/products/<%= p.id %>/delete">
                      <button class="btn btn-xs btn-error" onclick="return confirm('Are you sure to delete this product?')">Delete</button>
                    </form>
                  </div>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </main>

    <%- include('../footer') %>

  </body>
</html>

