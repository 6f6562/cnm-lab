NODE_ENV=development
PORT=3000

# DynamoDB
# - DYNAMODB_LOCAL=true để dùng DynamoDB Local (chạy qua docker)
# - DYNAMODB_ENDPOINT: URL tới DynamoDB Local
#
# Lưu ý: Tên table phải khớp với giá trị code đang dùng.
DYNAMODB_TABLE_PRODUCTS=Products
DYNAMODB_LOCAL=true
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_REGION=ap-southeast-1

# Credentials
# - Khi chạy DynamoDB Local, AWS SDK có thể không cần credentials thật,
#   nhưng code vẫn fallback sang giá trị ở đây.
#
# Điền theo tài khoản AWS của bạn khi cần chạy dịch vụ thật (không phải local).
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# Image storage: `local` | `s3`
IMAGE_STORAGE_PROVIDER=local

# S3 bucket (chỉ cần khi IMAGE_STORAGE_PROVIDER=s3)
AWS_S3_BUCKET=your-bucket-name

# Base URL public để hiển thị ảnh lên web (tuỳ cách bạn set bucket/CND/CDN).
# Ví dụ: https://your-bucket-name.s3.amazonaws.com
S3_PUBLIC_URL_BASE=

# Thư mục lưu ảnh nếu dùng storage local
LOCAL_UPLOAD_DIR=uploads

